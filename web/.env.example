# App password for login (required)
APP_PASSWORD=your-secure-password

# Session secret for cookie signing (required, min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-at-least-32-characters

# EMQX Cloud Serverless connection (required)
# Get from EMQX Cloud Console → Deployment → Overview
MQTT_BROKER=abc123.ala.us-east-1.emqxsl.com
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# WebSocket port for MQTT over WSS (default: 8084)
MQTT_WSS_PORT=8084
